<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 850" width="600" height="850">
  <defs>
    <linearGradient id="grad-118" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4a044e" />
      <stop offset="60%" stop-color="#701a75" />
      <stop offset="100%" stop-color="#0b0b10" />
    </linearGradient>
    <pattern id="grid-118" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#e879f9" stroke-width="0.75" stroke-opacity="0.15" />
    </pattern>
  </defs>
  
  <!-- Background -->
  <rect width="600" height="850" fill="url(#grad-118)" />
  <rect width="600" height="850" fill="url(#grid-118)" />
  
  <!-- Framing & Border -->
  <rect x="25" y="25" width="550" height="800" rx="16" fill="none" stroke="#e879f9" stroke-width="1.5" stroke-opacity="0.4" />
  <rect x="35" y="35" width="530" height="780" rx="12" fill="none" stroke="#e879f9" stroke-width="0.75" stroke-opacity="0.25" />
  
  <!-- Header Branding -->
  <text x="60" y="80" fill="#e879f9" font-family="sans-serif" font-size="14" font-weight="700" letter-spacing="3">NYAMORA ARCHIVE</text>
  <text x="540" y="80" fill="#94a3b8" font-family="sans-serif" font-size="12" text-anchor="end" font-weight="600">REF #NYM-118</text>
  
  <!-- Artistic Emblem / Geometric centerpiece -->
  <g transform="translate(300, 360)">
    <circle r="120" fill="none" stroke="#e879f9" stroke-width="2" stroke-opacity="0.3" stroke-dasharray="8 6" />
    <circle r="90" fill="#701a75" fill-opacity="0.5" stroke="#e879f9" stroke-width="1" />
    <polygon points="0,-70 60,35 -60,35" fill="none" stroke="#e879f9" stroke-width="2" stroke-opacity="0.6" />
    <polygon points="0,70 60,-35 -60,-35" fill="none" stroke="#fdf4ff" stroke-width="1.5" stroke-opacity="0.5" />
    <circle r="14" fill="#e879f9" />
    <!-- Cat silhouette / Host emblem -->
    <path d="M -18,-10 L -28,-30 L -8,-20 Z M 18,-10 L 28,-30 L 8,-20 Z" fill="#e879f9" />
  </g>
  
  <!-- Title & Meta Banner -->
  <rect x="50" y="580" width="500" height="180" rx="12" fill="#0b0b10" fill-opacity="0.85" stroke="#e879f9" stroke-width="1" stroke-opacity="0.4" />
  <text x="300" y="630" fill="#fdf4ff" font-family="sans-serif" font-size="22" font-weight="800" text-anchor="middle">CATALOGUE ENTRY 118</text>
  <text x="300" y="665" fill="#e2e8f0" font-family="sans-serif" font-size="15" font-weight="500" text-anchor="middle">OFFICIAL LICENSED METADATA</text>
  <text x="300" y="700" fill="#e879f9" font-family="sans-serif" font-size="13" font-weight="600" text-anchor="middle">NYAMORA CURATED COLLECTION</text>
  <text x="300" y="730" fill="#64748b" font-family="sans-serif" font-size="11" text-anchor="middle">RIGHTS CLEARED • ADULT-ACCESS ONLY</text>
  
  <!-- Footer -->
  <text x="300" y="805" fill="#475569" font-family="monospace" font-size="10" text-anchor="middle">SECURE METADATA REGISTER • COPYRIGHT COMPLIANT</text>
</svg>