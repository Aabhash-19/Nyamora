# ==============================================================================
# Nyamora (ニャモラ) Environment Configuration Template
# ==============================================================================

# Core Application Settings
NEXT_PUBLIC_APP_NAME="Nyamora"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (Optional: SQLite local default or PostgreSQL connection string)
DATABASE_URL="file:./data/nyamora.db"
# For PostgreSQL with pgvector (production):
# POSTGRES_URL="postgresql://user:password@localhost:5432/nyamora?sslmode=require"

# Authentication (Supabase / Provider-agnostic)
AUTH_SECRET="dev-insecure-secret-replace-in-production-min32chars"
NEXT_PUBLIC_AUTH_URL=""
NEXT_PUBLIC_AUTH_ANON_KEY=""
AUTH_SERVICE_ROLE_KEY=""

# AI Provider Configuration (Server-side only)
# Groq AI Provider (High-speed LLaMA 3.3 70B for seductive & teasing Nyan-chan Concierge)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Other LLM Providers (Google Gemini, OpenAI, or local deterministic simulation)
LLM_PROVIDER="groq" # "groq" | "demo" | "gemini" | "openai"
LLM_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
EMBEDDING_PROVIDER="demo" # "demo" | "gemini" | "openai"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-004"

# Catalogue Connectors (Disabled by default until rights reviewed)
CATALOGUE_PROVIDER="demo" # "demo" | "authorized_partner"
CATALOGUE_API_BASE_URL=""
CATALOGUE_API_KEY=""
NHENTAI_API_BASE_URL="https://nhentai.net/api/v2"
ENABLE_NHENTAI_SOURCE=true

# Community Outbound Links (Curated links enabled by default; API integration disabled)
COMMUNITY_PROVIDER="curated" # "curated" | "reddit_api"
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="web:nyamora-discovery:v1.0.0"

# Reader & Storage Architecture (Licensed assets only; disabled by default)
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_ENDPOINT=""

# Feature Flags (Strict Security Boundaries)
ENABLE_EXTERNAL_CATALOGUE=false
ENABLE_REDDIT_API=false
ENABLE_INTEGRATED_READER=false
ENABLE_EXTERNAL_READER_LINKS=true
ENABLE_USER_UPLOADS=false
